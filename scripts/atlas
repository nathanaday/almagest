#!/bin/sh
# Runs the installed atlas binary for the plugin's MCP server and hooks. The plugin holds
# skills and manifests; the binary is installed apart (atlas setup, or make install).
set -u
for candidate in \
  "${ATLAS_BIN:-}" \
  "${ATLAS_HOME:-$HOME/.atlas}/bin/atlas" \
  "$HOME/go/bin/atlas"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done
if [ "${1:-}" = "hook" ]; then
  # A hook never breaks a session. The session start tells the agent what is missing.
  if [ "${2:-}" = "session-start" ]; then
    echo "atlas: the atlas binary is not installed, so the atlas tools and hooks are off. Install it with: make install (in an atlas-obsidian checkout), or set ATLAS_BIN."
  fi
  cat >/dev/null
  exit 0
fi
echo "atlas: the atlas binary is not installed." >&2
echo "Install it with: make install (in an atlas-obsidian checkout), or set ATLAS_BIN to its path." >&2
exit 1
