#!/bin/sh
# Runs the installed almagest binary for the plugin's MCP server and hooks. The
# plugin holds skills and manifests; the binary is installed apart (almagest setup,
# or make install).
set -u
for candidate in \
  "${ALMAGEST_BIN:-}" \
  "${ALMAGEST_HOME:-$HOME/.almagest}/bin/almagest" \
  "$HOME/go/bin/almagest"
do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done
if [ "${1:-}" = "hook" ]; then
  # A hook never breaks a session. The session start tells the agent what is missing.
  if [ "${2:-}" = "session-start" ]; then
    echo "almagest: the almagest binary is not installed, so the almagest tools and hooks are off. Install it with: make install (in an almagest checkout), or set ALMAGEST_BIN."
  fi
  cat >/dev/null
  exit 0
fi
echo "almagest: the almagest binary is not installed." >&2
echo "Install it with: make install (in an almagest checkout), or set ALMAGEST_BIN to its path." >&2
exit 1
