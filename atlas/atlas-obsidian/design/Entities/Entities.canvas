		},
		{
			"id": "df35848a7a45e885",
			"type": "text",
			"text": "The agent Edits three sections of its own session document: Description, Progress, Summary",
			"x": 1550,
			"y": 1830,
			"width": 300,
			"height": 120,
			"color": "3"
		},
		{
			"id": "eb8ebee68518d0fd",
			"type": "text",
			"text": "**guard** allows only those sections of its own document",
			"x": 1960,
			"y": 1840,
			"width": 280,
			"height": 100,
			"color": "4"
		},
		{
			"id": "e31c1ef08f759fd2",
			"type": "text",
			"text": "**PostToolUse** hook copies the description into the frontmatter",
			"x": 2350,
			"y": 1835,
			"width": 300,
			"height": 110,
			"color": "4"
		},
		{
			"id": "568fdbb23ecde485",
			"type": "text",
			"text": "**vault**",
			"x": 0,
			"y": 2710,
			"width": 240,
			"height": 80,
			"color": "5"
		},
		{
			"id": "8e45ea291db8558a",
			"type": "file",
			"file": "design/Entities/Vault Status.md",
			"x": 350,
			"y": 2580,
			"width": 380,
			"height": 340,
			"color": "6"
		},
		{
			"id": "b7104df6b3e66c27",
			"type": "text",
			"text": "**SessionStart** hook prints it as the opening context",
			"x": 840,
			"y": 2695,
			"width": 300,
			"height": 110,
			"color": "4"
		},
		{
			"id": "1ec8d2c571b1d5b6",
			"type": "text",
			"text": "**lint**",
			"x": 1470,
			"y": 2710,
			"width": 240,
			"height": 80,
			"color": "5"
		},
		{
			"id": "c81cf5bc42366869",
			"type": "file",
			"file": "design/Entities/Findings.md",
			"x": 1820,
			"y": 2580,
			"width": 380,
			"height": 340,
			"color": "6"
		},
		{
			"id": "5a2ef0725f9b4cb1",
			"type": "text",
			"text": "**wiki-review** reads it; **wiki-edit** fixes it through a change",
			"x": 2310,
			"y": 2695,
			"width": 300,
			"height": 110,
			"color": "3"
		},
		{
			"id": "d8da977a2a94fcd7",
			"type": "text",
			"text": "**Legend**\n\n- cyan: tool (code)\n- yellow: skill or agent (model)\n- purple: document or entity\n- green: hook (code, automatic)\n- orange: the user\n- red: a gate or a refusal",
			"x": -460,
			"y": 0,
			"width": 300,
			"height": 260
		}
