			"color": "2"
		},
		{
			"id": "d2fc561c4e46328b",
			"type": "text",
			"text": "**change** apply\none commit",
			"x": 5530,
			"y": 470,
			"width": 240,
			"height": 80,
			"color": "5"
		},
		{
			"id": "4e4088fcd7a83b84",
			"type": "text",
			"text": "Wiki pages written; the absorbed documents are no longer pending",
			"x": 5880,
