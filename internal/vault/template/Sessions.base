filters:
  and:
    - file.inFolder("sessions")
    - 'type == "session"'
properties:
  file.name:
    displayName: Session
views:
  - type: table
    name: Now
    filters:
      or:
        - 'status == "waiting"'
        - 'status == "running"'
        - 'status == "idle"'
    order:
      - file.name
      - status
      - description
      - specs
      - repositories
      - updated
    sort:
      - property: status
        direction: DESC
      - property: updated
        direction: DESC
  - type: table
    name: Today
    filters:
      and:
        - 'file.ctime >= today()'
    order:
      - file.name
      - status
      - description
      - specs
      - changes
    sort:
      - property: started
        direction: DESC
  - type: table
    name: By spec
    groupBy:
      property: specs
      direction: ASC
    order:
      - file.name
      - status
      - description
    sort:
      - property: started
        direction: DESC
  - type: table
    name: By repository
    groupBy:
      property: repositories
      direction: ASC
    order:
      - file.name
      - status
      - description
      - specs
    sort:
      - property: started
        direction: DESC
  - type: table
    name: Lost
    filters:
      and:
        - 'status == "lost"'
    order:
      - file.name
      - description
      - specs
      - updated
