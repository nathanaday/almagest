filters:
  and:
    - file.inFolder("changes")
    - 'type == "change"'
properties:
  file.name:
    displayName: Change
views:
  - type: table
    name: Proposed
    filters:
      and:
        - 'status == "proposed"'
    order:
      - file.name
      - counts
      - absorbs
      - thread
      - session
      - proposed
    sort:
      - property: proposed
        direction: DESC
  - type: table
    name: Applied
    filters:
      and:
        - 'status == "applied"'
    order:
      - file.name
      - counts
      - absorbs
      - thread
      - applied
    sort:
      - property: applied
        direction: DESC
  - type: table
    name: By thread
    filters:
      and:
        - 'thread && thread != ""'
    groupBy:
      property: thread
      direction: ASC
    order:
      - file.name
      - status
      - counts
      - applied
  - type: table
    name: By session
    filters:
      and:
        - 'session && session != ""'
    groupBy:
      property: session
      direction: ASC
    order:
      - file.name
      - status
      - counts
      - applied
  - type: table
    name: Rejected and undone
    filters:
      or:
        - 'status == "rejected"'
        - 'status == "undone"'
        - 'status == "superseded"'
    order:
      - file.name
      - status
      - reason
      - updated
